# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars-long

# SQLite Database
DB_PATH=data/wiki_ref_fixer.db

# Wikimedia Policy Configuration
WIKIMEDIA_USER_AGENT=WikiRefFixer/1.0 (https://github.com/vikrampratap-wiki/wiki-reference-fixer; contact: toolforge)
MAXLAG=5
MAXLAG_MAX_RETRIES=3

# Website Admin RBAC Configuration
# Owner/Superadmin accounts (comma-separated). Non-admins accessing /admin receive strict 404.
SUPERADMIN_USERNAMES=विक्रम प्रताप,Vikram Pratap
ADMIN_ONWIKI_PAGE=सदस्य:विक्रम_प्रताप/wiki-ref-fixer-admins.json
ADMIN_SUBPAGE_CACHE_TTL_SECONDS=600

# Wikimedia OAuth 2.0 Credentials
WIKIMEDIA_OAUTH_CLIENT_ID=
WIKIMEDIA_OAUTH_CLIENT_SECRET=
WIKIMEDIA_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Wikimedia & External APIs
CITOID_API_URL=https://hi.wikipedia.org/api/rest_v1/data/citation/mediawiki
MEDIAWIKI_API_URL=https://hi.wikipedia.org/w/api.php
WAYBACK_API_URL=https://archive.org/wayback/available
